# ~/servicios/coach/.env en el VPS (permisos 600). Los secretos se escriben con `read -rsp`, nunca pegados en un chat.
NODE_ENV=production
APP_VERSION=1.0.0
# Subdominio público (Cloudflare Tunnel → http://coach:3000)
PUBLIC_URL=https://paquito.redgarverde.com
ALLOWED_ORIGINS=https://paquito.redgarverde.com
# Generados en el VPS: openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=
SETUP_CODE=
AUTH_RATE_LIMIT=10
LOG_LEVEL=info
# Avisos push (Web Push, VAPID). Los genera tools/deploy.mjs en el VPS la primera vez si faltan.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@redgarverde.com
# Demo pública (servicio `demo`). La contraseña la genera tools/deploy.mjs si falta.
DEMO_POSTGRES_PASSWORD=
DEMO_PUBLIC_URL=https://demo-paquito.redgarverde.com
# IA (Gemini, plan gratuito). Sin clave, la IA queda desactivada. La crea Paquito en https://aistudio.google.com/apikey
# y se escribe en el VPS con `read -rsp` (ver docs/OPERACIONES.md). El modelo se puede cambiar sin tocar código.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
AI_DAILY_LIMIT=150
