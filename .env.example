# Copia a .env (nunca se commitea). En el VPS: permisos 600 y valores escritos con `read -rsp`.
NODE_ENV=development
PORT=3000
# Postgres de desarrollo (docker-compose.dev.yml). En producción apunta al servicio `db` de la red interna.
DATABASE_URL=postgres://coach:coach@127.0.0.1:5433/coach
# Orígenes permitidos (CORS + comprobación de Origin en peticiones que modifican datos).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# URL pública (enlaces de invitación). En producción, el subdominio real.
PUBLIC_URL=http://localhost:5173
# Límite de intentos de acceso por IP y minuto (los e2e lo suben).
AUTH_RATE_LIMIT=10
LOG_LEVEL=info
